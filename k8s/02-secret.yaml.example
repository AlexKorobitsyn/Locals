apiVersion: v1
kind: Secret
metadata: {name: locals-secret, namespace: locals}
type: Opaque
stringData:
  JWT_SECRET_KEY: REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
  POSTGRES_PASSWORD: REPLACE_WITH_POSTGRES_PASSWORD
  DATABASE_URL: postgresql+asyncpg://music:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/music
  MINIO_ROOT_PASSWORD: REPLACE_WITH_MINIO_PASSWORD
  S3_SECRET_KEY: REPLACE_WITH_MINIO_PASSWORD
