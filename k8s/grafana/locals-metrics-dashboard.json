    {
      "datasource": {
        "type": "prometheus",
        "uid": "locals-victoriametrics"
      },
      "description": "Проврека  SLA через пробер. Сначала (kubectl -n locals scale deployment/prober --replicas=1)\nпорог 99%, окно 30 дней",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "max": 100,
          "min": 0,
          "noValue": "Нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "locals-victoriametrics"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "WITH (\r\n  sli = (\r\n    100 *\r\n    sum by (scenario) (\r\n      increase(locals_probe_checks_total{\r\n        job=\"locals-pods\",\r\n        namespace=\"locals\",\r\n        pod=~\"prober-.*\",\r\n        scenario=~\"login|audio_upload|review\",\r\n        result=\"success\"\r\n      }[30d])\r\n    )\r\n    /\r\n    sum by (scenario) (\r\n      increase(locals_probe_checks_total{\r\n        job=\"locals-pods\",\r\n        namespace=\"locals\",\r\n        pod=~\"prober-.*\",\r\n        scenario=~\"login|audio_upload|review\"\r\n      }[30d])\r\n    )\r\n  )\r\n  and on (scenario) (\r\n    time() - max by (scenario) (\r\n      locals_probe_last_completed_timestamp_seconds{\r\n        job=\"locals-pods\",\r\n        namespace=\"locals\",\r\n        pod=~\"prober-.*\",\r\n        scenario=~\"login|audio_upload|review\"\r\n      }\r\n    ) < 120\r\n  )\r\n  and on () (\r\n    max(up{\r\n      job=\"locals-pods\",\r\n      namespace=\"locals\",\r\n      pod=~\"prober-.*\"\r\n    }) == 1\r\n  )\r\n)\r\nmin(sli) and on () (count(sli) == 3)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Минимальный процент успеха пробера",
      "type": "stat"
    }
