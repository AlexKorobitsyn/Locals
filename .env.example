APP_NAME="Music Service"
APP_IMAGE=music-service:dev
PORT=8000
LOG_LEVEL=INFO

# Сгенерьте отдельный секрет минимум 32 
JWT_SECRET_KEY=random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ISSUER=music-service
JWT_AUDIENCE=music-service-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
#в проде задать HTTPS  и BROWSER_COOKIE_SECURE=true.
BROWSER_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]'
BROWSER_COOKIE_SECURE=false
FRONTEND_IMAGE=locals-frontend:dev
FRONTEND_PORT=8080
FRONTEND_BIND_HOST=127.0.0.1
UPLOAD_MAX_BODY_SIZE=128m
API_READ_TIMEOUT=600s
BCRYPT_ROUNDS=12

RATING_PRIOR_STRENGTH=50
RATING_PRIOR_MEAN=3
RATING_WEIGHT_GREEN=1
RATING_WEIGHT_EXPERIENCED=2
RATING_WEIGHT_MODERATOR=2
RATING_WEIGHT_ADMIN=2

POSTGRES_IMAGE=postgres:16
POSTGRES_DB=music
POSTGRES_USER=music
POSTGRES_PASSWORD=local_dev_password
# Если пароль содержит специальные символы, URL -кодируйте его в DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://music:local_dev_password@db:5432/music

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=30
HEALTH_TIMEOUT_SECONDS=3
SHUTDOWN_TIMEOUT_SECONDS=10
STOP_GRACE_PERIOD=15s

HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=10s

MINIO_IMAGE=music-minio:RELEASE.2025-10-15T17-29-55Z
MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=local_minio_user
MINIO_ROOT_PASSWORD=replace_with_a_random_minio_password
S3_ENDPOINT_URL=http://storage:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local_minio_user
S3_SECRET_KEY=replace_with_a_random_minio_password
S3_BUCKET=music
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=300
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=30
S3_INIT_TIMEOUT_SECONDS=60
S3_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]'
IMAGE_MAX_BYTES=10485760
AUDIO_MAX_BYTES=104857600
IMAGE_MAX_PIXELS=25000000

MINIO_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Весрекомендаций 
RECOMMENDATION_FAVORITE_WEIGHT=2
RECOMMENDATION_RATED_WEIGHT=1
RECOMMENDATION_QUALITY_WEIGHT=1
CORS_ORIGINS='[]'

# Метаданные
RELEASE_ID=dev
VCS_REF=unknown
VCS_URL=https://github.com/AlexKorobitsyn/Locals
APP_BIND_HOST=127.0.0.1
MINIO_BIND_HOST=127.0.0.1
RESTART_POLICY=unless-stopped
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Пустое значение использует внешние PostgreSQL/S3, local - локальные)
COMPOSE_PROFILES=local

# Девять уровней опыта
EXPERIENCE_LYRICS_POINTS=100
EXPERIENCE_GENRES_POINTS=300
EXPERIENCE_SCENE_POINTS=700
EXPERIENCE_HIGHER_THRESHOLDS=[1500,3000,6000,12000,25000]
CONTRIBUTION_LIMITS=[2,3,5,8,12,18,25,35,50]
CONTRIBUTION_VOTES_REQUIRED=5
EVENT_ACTIVE_LIMIT=5
EVENT_LEGEND_LIMIT=20
LISTEN_DAILY_CAP=20
MICRO_DAILY_CAP=5
REVIEW_DAILY_CAP=2
REVIEW_POINTS=20
MILESTONE_POINTS=100
QUALITY_TRACK_POINTS=20
QUALITY_MIN_RATERS=3
QUALITY_MIN_RATING=4
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
